  "query": "\n            INSERT INTO cleanup_log_t (start_unix_tstamp_secs, marked_folders, deleted_folders, failed_folders)\n            SELECT $1, '[]'::jsonb, '[]'::jsonb, '[]'::jsonb\n            WHERE NOT EXISTS (\n                SELECT 1 FROM cleanup_log_t\n                WHERE start_unix_tstamp_secs > ($1::bigint - $2::bigint)\n            )\n            RETURNING *\n    ",
