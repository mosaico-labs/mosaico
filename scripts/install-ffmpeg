#!/usr/bin/env bash
#
# Builds FFmpeg from source and installs its static libraries into a prefix,
# for `mosaicod-video`: FFmpeg's own FFV1 encoder and decoder, and its MP4
# muxer and demuxer. mosaicod links them in (the `video-static` feature), so it
# needs nothing of FFmpeg to run.
#
# Usage: scripts/install-ffmpeg [PREFIX]   (default: /opt/ffmpeg)
#
# Needs a C toolchain, `curl`, `xz`, `nasm` and `pkg-config`: on Debian and
# Ubuntu,
#
#   apt-get install build-essential curl xz-utils nasm pkg-config
#
# Then build mosaicod with `PKG_CONFIG_PATH=PREFIX/lib/pkgconfig` and
# `--features video-static` (on macOS, set `FFMPEG_DIR=PREFIX` instead: the
# FFmpeg bindings look in Homebrew first).
#
# FFmpeg is LGPL 2.1 or later, as configured here (no GPL or non-free parts):
# its license and where its source is are installed in
# `PREFIX/share/licenses/ffmpeg`, to ship with what links it.
#
# Only the libraries, codecs and formats mosaicod uses are built, and no other
# system library is picked up (`--disable-autodetect`), so the libraries
# depend only on the C library and the math library.

set -euo pipefail

FFMPEG_VERSION="9.0.2"
FFMPEG_SHA256="8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e"

PREFIX="${1:-/opt/ffmpeg}"
JOBS="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)"

work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT
cd "${work}"

archive="ffmpeg-${FFMPEG_VERSION}.tar.xz"
curl -fsSL --retry 3 -o "${archive}" "https://ffmpeg.org/releases/${archive}"
if command -v sha256sum >/dev/null 2>&1; then
    echo "${FFMPEG_SHA256}  ${archive}" | sha256sum --check --quiet -
else
    echo "${FFMPEG_SHA256}  ${archive}" | shasum -a 256 --check --quiet -
fi
tar -xJf "${archive}"
cd "ffmpeg-${FFMPEG_VERSION}"

./configure \
    --prefix="${PREFIX}" \
    --enable-static \
    --disable-shared \
    --enable-pic \
    --disable-programs \
    --disable-doc \
    --disable-avdevice \
    --disable-avfilter \
    --disable-network \
    --disable-autodetect \
    --disable-everything \
    --enable-pthreads \
    --enable-encoder=ffv1 \
    --enable-decoder=ffv1 \
    --enable-muxer=mp4 \
    --enable-demuxer=mov \
    --enable-protocol=file

make -j"${JOBS}"
make install

licenses="${PREFIX}/share/licenses/ffmpeg"
mkdir -p "${licenses}"
cp COPYING.LGPLv2.1 LICENSE.md "${licenses}/"
cat > "${licenses}/SOURCE" <<EOF
FFmpeg ${FFMPEG_VERSION}, linked statically into mosaicod.
Source: https://ffmpeg.org/releases/${archive} (SHA-256 ${FFMPEG_SHA256})
Configured with only the FFV1 encoder and decoder, the MP4 muxer and demuxer,
and the file protocol: see scripts/install-ffmpeg in the mosaico repository.
EOF

echo "FFmpeg ${FFMPEG_VERSION} installed into ${PREFIX}"
