#!/usr/bin/env bash

set -euo pipefail

# Configuration
MOSAICOD_OUTPUT="/tmp/mosaicod_e2e_testing.out"
PYTHON_SDK_DIR="mosaico-sdk-py"
MOSAICOD_DIR="mosaicod"
DOCKER_DIR="docker/testing"

# Environment variables (with defaults)
export RUST_LOG="mosaico=trace"
export MOSAICOD_DB_URL="postgresql://localhost:6543/mosaico"
export MOSAICOD_DB_USER="postgres"
export MOSAICOD_DB_PASSWORD="password"
export MOSAICOD_STORE_ENDPOINT="file:///tmp"
export MOSAICOD_STORE_BUCKET="mosaico-auto-testing"
export RUST_BACKTRACE="${RUST_BACKTRACE:-1}"
export SQLX_OFFLINE="true"
export DATABASE_URL="postgresql://${MOSAICOD_DB_USER}:${MOSAICOD_DB_PASSWORD}@$(printf '%s' "${MOSAICOD_DB_URL}" | sed 's#^postgresql://##')"

# Resolve paths in a way that works on macOS and Linux.
FILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_DIR="$(cd "${FILE_DIR}/.." && pwd -P)"

MOSAICOD_PATH="${PROJECT_DIR}/${MOSAICOD_DIR}"
PYTHON_SDK_PATH="${PROJECT_DIR}/${PYTHON_SDK_DIR}"
DOCKER_PATH="${PROJECT_DIR}/${DOCKER_DIR}"

# Colors (with fallback for non-interactive terminals)
setup_colors() {
    if [ -t 1 ] && command -v tput >/dev/null 2>&1; then
        COLS="$(tput cols 2>/dev/null || echo 80)"
        RED="$(tput setaf 1 2>/dev/null || true)"
        GREEN="$(tput setaf 2 2>/dev/null || true)"
        YELLOW="$(tput setaf 3 2>/dev/null || true)"
        BLUE="$(tput setaf 4 2>/dev/null || true)"
        MAGENTA="$(tput setaf 5 2>/dev/null || true)"
        RESET="$(tput sgr0 2>/dev/null || true)"
        BOLD="$(tput bold 2>/dev/null || true)"
        DIM="$(tput dim 2>/dev/null || true)"
    else
        COLS=80
        RED=""
        GREEN=""
        YELLOW=""
        BLUE=""
        MAGENTA=""
        RESET=""
        BOLD=""
        DIM=""
    fi

    if [ "${COLS}" -lt 70 ]; then
        COLS=70
    fi
}

# State tracking
MOSAICOD_PID=""
DOCKER_STARTED=false

# Supports both the modern `docker compose` plugin and legacy
# `docker-compose`.
docker_compose() {
    if docker compose version >/dev/null 2>&1; then
        docker compose "$@"
    elif command -v docker-compose >/dev/null 2>&1; then
        docker-compose "$@"
    else
        echo "${RED}${BOLD}Error: Docker Compose is not installed.${RESET}" >&2
        echo "Install Docker Compose or Docker Desktop/Colima." >&2
        return 1
    fi
}

# Cleanup function
cleanup() {
    if [ -n "${MOSAICOD_PID}" ]; then
        kill "${MOSAICOD_PID}" 2>/dev/null || true
        wait "${MOSAICOD_PID}" 2>/dev/null || true
        echo "${DIM}mosaicod (${MOSAICOD_PID}) terminated.${RESET}"
    fi

    if [ "${DOCKER_STARTED}" = true ]; then
        (
            cd "${DOCKER_PATH}" &&
            docker_compose down -v >/dev/null 2>&1 || true
        )
    fi

    MOSAICOD_PID=""
    DOCKER_STARTED=false
}

trap cleanup EXIT

# Print title
title() {
    local text="$1"
    local char="${2:-#}"
    local color="${3:-${MAGENTA}}"
    local padding=$(( (COLS - ${#text} - 2) / 2 ))
    local line

    if [ "${padding}" -lt 0 ]; then
        padding=0
    fi

    printf -v line "%*s" "${COLS}" ""
    line=${line// /${char}}

    printf "%s%s%.*s %s %.*s%s\n" \
        "${color}" "${BOLD}" \
        "${padding}" "${line}" \
        "${text}" \
        "${padding}" "${line}" \
        "${RESET}"
}

# Error handler
error_handler() {
    echo "${RED}${BOLD}Error occurred. Exiting.${RESET}" >&2
    exit 1
}

trap error_handler ERR

# Show help
show_help() {
    cat <<EOF
Mosaico test runner.

Usage: tests.sh [OPTIONS]

Options:
    --mosaicod                  Run mosaicod unit tests (requires Docker for PostgreSQL)
    --sdk-python                Run Python SDK unit tests (no Docker required)
    --full-stack                Run full-stack tests (requires Docker + mosaicod build)
    --full-stack-tls            Run full-stack tests with TLS (requires Docker + mosaicod build)
    --full-stack-api-key        Run full-stack tests with API KEY (requires Docker + mosaicod build)
    --full-stack-gzip           Run full-stack tests with gzip compression enabled (requires Docker + mosaicod build)
    --full-stack-all            Run all full-stack tests (requires Docker + mosaicod build)
    --all                       Run all tests (default)
    --verbose, -v               Show verbose output
    --help, -h                  Show this help message
EOF
}

start_docker() {
    if [ "${DOCKER_STARTED}" = false ]; then
        title "docker" "." "${BLUE}"

        cd "${DOCKER_PATH}"

        if [ "${VERBOSE}" = true ]; then
            docker_compose up -d --wait
        else
            docker_compose up -d --wait >/dev/null 2>&1
        fi

        DOCKER_STARTED=true
        echo "Started ${BOLD}docker/testing${RESET} compose file"
    fi
}

# Install Python dependencies
install_python_deps() {
    title "poetry" "." "${BLUE}"

    cd "${PYTHON_SDK_PATH}"
    poetry install --extras cli
}

# Run mosaicod unit tests
run_mosaicod_tests() {
    start_docker

    title "mosaicod (unit tests)" "-"
    cd "${MOSAICOD_PATH}"

    if [ "${VERBOSE}" = true ]; then
        cargo test --jobs 6
    else
        echo "Compiling, it may take some time ..."
        cargo test --quiet
    fi
}

# Run Python SDK unit tests
run_sdk_python_tests() {
    title "python sdk (unit tests)" "-"

    install_python_deps

    cd "${PYTHON_SDK_PATH}"
    poetry run pytest ./src/testing -k unit
}

# Run full-stack tests.
#
# Usage:
#   run_full_stack_tests --title "title"
#   run_full_stack_tests --title "title" --tls
run_full_stack_tests() {
    local PYTEST_OPTS_K="integration and not test_tls_connection"
    local PYTEST_OPTS=""
    local GENERATE_API_KEY=false
    local TITLE="N/A"

    # Reset per-variant server toggles so they don't leak between
    # successive run_full_stack_tests calls.
    export MOSAICOD_TLS_ENABLED=false
    export MOSAICOD_GZIP_ENABLED=false
    export MOSAICOD_API_KEY_ENABLED=false

    while [ $# -gt 0 ]; do
        case "$1" in
            --tls)
                PYTEST_OPTS_K="integration"
                PYTEST_OPTS="--tls"

                export MOSAICOD_TLS_ENABLED=true
                export MOSAICOD_TLS_CERT_FILE="${MOSAICOD_PATH}/tests/data/cert.pem"
                export MOSAICOD_TLS_PRIVATE_KEY_FILE="${MOSAICOD_PATH}/tests/data/key.pem"
                export MOSAICO_TLS_CERT_FILE="${MOSAICOD_PATH}/tests/data/ca.pem"

                shift
                ;;

            --gzip)
                PYTEST_OPTS_K="integration"
                PYTEST_OPTS="--gzip"

                export MOSAICOD_GZIP_ENABLED=true

                shift
                ;;

            --api-key)
                PYTEST_OPTS_K="integration"
                GENERATE_API_KEY=true

                export MOSAICOD_API_KEY_ENABLED=true

                shift
                ;;

            --title)
                TITLE="$2"
                shift 2
                ;;

            *)
                shift
                ;;
        esac
    done

    cleanup
    start_docker

    title "[ ${TITLE} ]" "-"

    install_python_deps

    # Build mosaicod
    title "mosaicod build" "." "${BLUE}"
    cd "${MOSAICOD_PATH}"

    if [ "${VERBOSE}" = true ]; then
        cargo build --jobs 6 --bin mosaicod
    else
        echo "Compiling mosaicod, it may take a while ..."
        cargo build --bin mosaicod
    fi

    # Generate API keys if required.
    if [ "${GENERATE_API_KEY}" = true ]; then
        MOSAICO_API_KEY_READ="$(
            RUST_LOG="" "${MOSAICOD_PATH}/target/debug/mosaicod" api-key create -p read
        )"

        MOSAICO_API_KEY_WRITE="$(
            RUST_LOG="" "${MOSAICOD_PATH}/target/debug/mosaicod" api-key create -p write
        )"

        MOSAICO_API_KEY_DELETE="$(
            RUST_LOG="" "${MOSAICOD_PATH}/target/debug/mosaicod" api-key create -p delete
        )"

        MOSAICO_API_KEY_MANAGE="$(
            RUST_LOG="" "${MOSAICOD_PATH}/target/debug/mosaicod" api-key create -p "read|write|delete"
        )"

        PYTEST_OPTS="--api-key-read ${MOSAICO_API_KEY_READ} \
--api-key-write ${MOSAICO_API_KEY_WRITE} \
--api-key-delete ${MOSAICO_API_KEY_DELETE} \
--api-key-manage ${MOSAICO_API_KEY_MANAGE}"
    fi

    # Start mosaicod
    title "mosaicod startup" "." "${BLUE}"

    cd "${MOSAICOD_PATH}"

    ./target/debug/mosaicod server --port 6276 >"${MOSAICOD_OUTPUT}" 2>&1 &
    MOSAICOD_PID=$!

    echo "Starting mosaicod as background service (pid ${MOSAICOD_PID})"
    echo "mosaicod logs can be found in ${DIM}${MOSAICOD_OUTPUT}${RESET}"
    echo "Waiting for mosaicod to start ..."

    sleep 1

    # Run full-stack tests
    title "running full-stack tests" "." "${BLUE}"

    cd "${PYTHON_SDK_PATH}"
    poetry run pytest ./src/testing -k "${PYTEST_OPTS_K}" ${PYTEST_OPTS}
}

VERBOSE=false

# Main
main() {
    setup_colors

    local run_mosaicod=false
    local run_sdk_python=false
    local run_full_stack=false
    local run_full_stack_tls=false
    local run_full_stack_gzip=false
    local run_full_stack_api_key=false
    local run_all=false
    local run_selected=false

    while [ $# -gt 0 ]; do
        case "$1" in
            --verbose|-v)
                VERBOSE=true
                shift
                ;;

            --mosaicod)
                run_mosaicod=true
                run_selected=true
                shift
                ;;

            --sdk-python)
                run_sdk_python=true
                run_selected=true
                shift
                ;;

            --full-stack)
                run_full_stack=true
                run_selected=true
                shift
                ;;

            --full-stack-tls)
                run_full_stack_tls=true
                run_selected=true
                shift
                ;;

            --full-stack-gzip)
                run_full_stack_gzip=true
                run_selected=true
                shift
                ;;

            --full-stack-api-key)
                run_full_stack_api_key=true
                run_selected=true
                shift
                ;;

            --full-stack-all)
                run_full_stack=true
                run_full_stack_tls=true
                run_full_stack_gzip=true
                run_full_stack_api_key=true
                run_selected=true
                shift
                ;;

            --all)
                run_all=true
                run_selected=true
                shift
                ;;

            --help|-h)
                show_help
                exit 0
                ;;

            *)
                echo "${RED}Unknown option: $1${RESET}" >&2
                show_help
                exit 1
                ;;
        esac
    done

    # If no option was specified, run everything.
    if [ "${run_selected}" = false ]; then
        run_all=true
    fi

    title "test runner" "#" "${GREEN}"

    # Print configuration
    title "[ setup ]" "-"

    echo " * MOSAICOD_DB_URL            ${DIM}${MOSAICOD_DB_URL}${RESET}"
    echo " * DATABASE_URL               ${DIM}${DATABASE_URL}${RESET}"
    echo " * SQLX_OFFLINE               ${DIM}${SQLX_OFFLINE}${RESET}"
    echo " * MOSAICOD_STORE_ENDPOINT    ${DIM}${MOSAICOD_STORE_ENDPOINT}${RESET}"
    echo " * MOSAICOD_STORE_BUCKET      ${DIM}${MOSAICOD_STORE_BUCKET}${RESET}"

    # Run selected tests
    if [ "${run_all}" = true ]; then
        run_mosaicod_tests
        run_sdk_python_tests
        run_full_stack_tests --title "full-stack tests"
        run_full_stack_tests --title "full-stack tests (TLS)" --tls
        run_full_stack_tests --title "full-stack tests (API KEY)" --api-key
        run_full_stack_tests --title "full-stack tests (GZIP)" --gzip
    else
        if [ "${run_mosaicod}" = true ]; then
            run_mosaicod_tests
        fi

        if [ "${run_sdk_python}" = true ]; then
            run_sdk_python_tests
        fi

        if [ "${run_full_stack}" = true ]; then
            run_full_stack_tests --title "full-stack tests"
        fi

        if [ "${run_full_stack_tls}" = true ]; then
            run_full_stack_tests --title "full-stack tests (TLS)" --tls
        fi

        if [ "${run_full_stack_gzip}" = true ]; then
            run_full_stack_tests --title "full-stack tests (GZIP)" --gzip
        fi

        if [ "${run_full_stack_api_key}" = true ]; then
            run_full_stack_tests --title "full-stack tests (API KEY)" --api-key
        fi
    fi

    title "all done" "#" "${GREEN}"
}

main "$@"
