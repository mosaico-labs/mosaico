#!/usr/bin/env bash

# Verifies that a release tag is signed with the Mosaico release key (.github/release-key.asc).
# Used by the release workflows before building, and by anyone who wants to check a release.
#
# Usage: .github/scripts/verify-release-tag <tag>

set -euo pipefail

if [[ $# -ne 1 || "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: $(basename "$0") <tag>"
    exit 1
fi

TAG="$1"
PROJECT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)

# A temporary GnuPG home holding only the release key, so no other key in the keyring is trusted.
GNUPGHOME=$(mktemp -d)
export GNUPGHOME
trap 'gpgconf --kill all 2> /dev/null || true; rm -rf "$GNUPGHOME"' EXIT

gpg --batch --quiet --import "$PROJECT_DIR/.github/release-key.asc"
git -C "$PROJECT_DIR" verify-tag "$TAG"
