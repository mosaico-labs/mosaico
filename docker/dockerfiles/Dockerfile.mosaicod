FROM rust:1.92-slim-bookworm AS builder

ARG GIT_HASH=undefined
# Base64 encoded release tag object (`git cat-file tag vX.Y.Z | base64 -w0`), set only for release
# builds since `.git` is not part of the image.
ARG MOSAICOD_RELEASE_TAG=

WORKDIR /mosaicod

RUN apt-get update && \
  apt-get install -y \
  pkg-config \
  libpq-dev \
  build-essential \
  ca-certificates 

COPY mosaicod/Cargo.toml mosaicod/Cargo.lock ./
COPY mosaicod/crates ./crates
COPY mosaicod/tests ./tests
COPY mosaicod/bin ./bin
# mosaicod-proto's build.rs reads `.proto` files from the repo-root `proto/`
# folder (three levels up from crates/mosaicod-proto) — mirror that layout
# here since the build context is now the repo root, not `mosaicod/`.
COPY proto /proto

RUN GIT_HASH=${GIT_HASH} MOSAICOD_RELEASE_TAG=${MOSAICOD_RELEASE_TAG} SQLX_OFFLINE=true cargo build --bin mosaicod --profile docker

FROM gcr.io/distroless/cc-debian12

WORKDIR /mosaicod

COPY --from=builder /mosaicod/target/docker/mosaicod /usr/local/bin/mosaicod

ENTRYPOINT ["mosaicod"]
